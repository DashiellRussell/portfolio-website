# SMTP Email Configuration
# These are required for the contact form to work

# SMTP Server (e.g., smtp.gmail.com for Gmail)
SMTP_HOST=smtp.gmail.com

# SMTP Port (587 for TLS, 465 for SSL)
SMTP_PORT=587

# Your email address (the account sending emails)
SMTP_USER=your.email@gmail.com

# Your email password or app-specific password
# For Gmail: Generate an "App Password" at https://myaccount.google.com/apppasswords
SMTP_PASS=your-app-password-here

# Where contact form submissions should be sent
EMAIL_TO=dashiell.russell@gmail.com

# Optional: From address (defaults to SMTP_USER if not set)
EMAIL_FROM=your.email@gmail.com
